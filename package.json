{
  "name": "@sindomecorp/moo-in-javascript",
  "version": "0.2.5",
  "description": "Embed an educational LambdaMOO and ToastStunt interpreter in Node.js and browsers.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node scripts/assets.mjs && tsc && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "prepack": "npm run build",
    "rebuild:grammar": "node scripts/rebuild-grammar.mjs",
    "example:node": "npm run build && node examples/node.mjs",
    "example:browser": "npm run build && node scripts/serve.mjs",
    "test:clean": "node scripts/test-clean.mjs",
    "test:checkout": "node scripts/test-checkout.mjs",
    "test:coverage": "npm run build && node scripts/test-coverage.mjs"
  },
  "keywords": [
    "moo",
    "lambdamoo",
    "toaststunt",
    "interpreter",
    "typescript",
    "webassembly"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "re2js": "2.8.6",
    "sql.js": "1.14.2",
    "unix-crypt-td-js": "1.1.4",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": "./dist/worker/browser.js",
    "./assets/*": "./assets/*",
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.js"
    },
    "./browser/fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/browser/fixtures.js"
    },
    "./node-worker": {
      "types": "./dist/worker/node-client.d.ts",
      "import": "./dist/worker/node-client.js"
    },
    "./worker-handler": {
      "types": "./dist/worker/handler.d.ts",
      "import": "./dist/worker/handler.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SindomeCorp/moo-in-javascript.git"
  },
  "homepage": "https://github.com/SindomeCorp/moo-in-javascript#readme",
  "bugs": {
    "url": "https://github.com/SindomeCorp/moo-in-javascript/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
